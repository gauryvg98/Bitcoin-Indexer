# Bitcoin Indexer C# Configuration Example
# Copy this file to config.env and update with your settings

# Database Configuration
DATABASE_URL=Host=localhost;Database=bitcoin_indexer;Username=postgres;Password=your_password

# Bitcoin RPC Configuration
BTC_RPC_URL=http://localhost:8332
BTC_RPC_USERNAME=your_rpc_username
BTC_RPC_PASSWORD=your_rpc_password

# Indexer Configuration
BLOCK_POLL_INTERVAL_SECONDS=10
MEMPOOL_POLL_INTERVAL_SECONDS=5
BACKFILL_WORKERS=10
MAX_REORG_DEPTH=10

# API Configuration
SERVER_PORT=8080

# Logging Configuration
LOG_LEVEL=Information
