# Bitcoin RPC Configuration (Required)
BTC_RPC_URL=http://localhost:8332
BTC_RPC_USERNAME=your_rpc_username
BTC_RPC_PASSWORD=your_rpc_password

# Database Configuration (Required)
DATABASE_URL=postgres://user:password@localhost:5432/bitcoin_indexer?sslmode=disable

# Indexer Settings
BLOCK_POLL_INTERVAL=10s
MEMPOOL_POLL_INTERVAL=5s
BACKFILL_WORKERS=20
MAX_REORG_DEPTH=10

# API Server
SERVER_PORT=8080
